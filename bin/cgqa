#!/usr/bin/env node
// Deprecated alias for bin/graph-assay (codegraph-qa's old name), kept for one release.
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';
import * as path from 'node:path';

const main = path.join(path.dirname(fileURLToPath(import.meta.url)), 'graph-assay');
const r = spawnSync(process.execPath, [main, ...process.argv.slice(2)], { stdio: 'inherit' });
if (r.error) console.error(`cgqa: could not run graph-assay: ${r.error.message}`);
process.exit(r.status ?? 1);
