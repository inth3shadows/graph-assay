#!/usr/bin/env node
// One entry point for graph-assay. `graph-assay help` lists the commands; each forwards its arguments
// to the script that does the work, so the scripts stay usable on their own.
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';
import * as path from 'node:path';

const qa = path.dirname(path.dirname(fs.realpathSync(fileURLToPath(import.meta.url))));
const p = (...x) => path.join(qa, ...x);
const COMMANDS = {
  setup: ['bash', p('tools/setup.sh'), '[--codegraph <commit>] [--no-codegraph] [--no-cgr] [--no-scip] [--dry-run]: SCIP tools and a build of each subject, where config looks'],
  replay: ['node', p('fixtures/replay.mts'), '<codegraph.js> [fixture ...] [--json out] [--canary]: fixture verdicts and optional anonymous canary replay'],
  oracle: ['bash', p('oracle/run.sh'), '<name> <src repo> <ts|python|go|jvm> [ts dirs...]: index + SCIP + oracle, forward and missing'],
  'oracle-all': ['bash', p('oracle/run-all.sh'), '[targets file]: oracle on every target'],
  meta: ['node', p('metamorphic/run.ts'), '<codegraph.js> <seed dir|fixtures ...> [--relations decoy,shift,repeat] [--json out]'],
  pycg: ['node', p('benchmarks/pycg.ts'), '<codegraph.js> [category ...] [--json out]: PyCG micro-benchmark'],
  selftest: ['node', p('oracle/test/run.ts'), '[--mutate] [--dump] [case ...]: hermetic oracle self-tests'],
  baseline: ['node', p('oracle/baseline.ts'), 'save <dir> | diff <old baseline.json> <new baseline.json> [--fail-on-regression] [--json gate.json]'],
  snapshot: ['node', p('lib/subjects/codegraph.ts'), 'snapshot <dir> <out.json> [codegraph.js] | index <dir> <codegraph.js>'],
  expect: ['node', p('lib/expect.ts'), '[dir ...]: validate every expect.json'],
  config: ['node', p('lib/config.ts'), '[key]: resolved paths'],
  conformance: ['node', p('lib/conformance.ts'), '<codegraph.js>: is the adapter faithful, and how does the subject handle awkward cases'],
  modes: ['node', p('differential/modes.ts'), '<codegraph.js> <dir ...> [--modes ..] [--json out]: execution modes (kernel, workers, sync, repeat) diffed against base'],
  builds: ['node', p('differential/builds.ts'), '<old codegraph.js> <new codegraph.js> <dir ...> [--md out] [--json out] | --fetch <dest>: two builds, canonical graph diff'],
  triage: ['node', p('bench/triage.ts'), '[--work <oracle work dir>] [--t3 <dir>] [--top N] [--md out] [--json out]: subject bugs ranked by the headline points they cost, from an oracle run'],
  site: ['node', p('oracle/site.ts'), '<name | work dir> <file:line> [called name] [--subject s|all] [--no-scip]: one call site explained (records, meaning, SCIP definition, edges) and its re-run command'],
  shadow: ['node', p('differential/shadow.ts'), '<old codegraph.js> <new codegraph.js> [questions.json] [--show N] [--json out]: agent-facing answers (explore, callers, ...) diffed between builds'],
};

const [cmd, ...args] = process.argv.slice(2);
if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') {
  console.log('usage: graph-assay <command> [args]\n');
  for (const [k, [, , help]] of Object.entries(COMMANDS)) console.log(`  ${k.padEnd(11)} ${help}`);
  console.log(`  ${'check'.padEnd(11)} syntax-check every script, type-check the TypeScript scripts, validate fixtures, self-tests with --mutate (what CI runs; needs 'npm ci --ignore-scripts' first)`);
  process.exit(cmd ? 0 : 2);
}

if (cmd === 'check') {
  const files = (spawnSync('git', ['ls-files'], { cwd: qa, encoding: 'utf8' }).stdout ?? '').split('\n').filter(Boolean);
  // Outside a git checkout the file list is empty and every syntax check would be skipped silently.
  if (!files.length) { console.error('check needs a git checkout (git ls-files listed nothing)'); process.exit(2); }
  const listed = ['lib/expect.ts', 'oracle/test/run.ts', 'differential/test.ts', 'labels/test.ts', 'oracle/site-test.ts',
    'oracle/ts-cover-test.ts', 'lib/scores-test.ts', 'lib/spec-test.ts', 'lib/anti-gaming-test.ts', 'bench/robustness-test.ts',
    'bench/tables-test.ts', 'bench/triage-test.ts', 'tools/repro-test.mjs'];
  // A new *-test.mjs, or *-test.ts among the TypeScript scripts, runs without anyone remembering to list
  // it. Only these .ts are scripts (the same set as tsconfig.json's include): elsewhere (oracle/test/<case>/,
  // conformance, fixtures) a .ts is an indexed test source.
  const scriptTs = (f) => f.endsWith('.ts') && (f.startsWith('lib/') || /^(oracle\/(test\/)?|bench\/|metamorphic\/|benchmarks\/|differential\/|labels\/)[^/]+\.ts$/.test(f));
  const discovered = files.filter((f) => (f.endsWith('-test.mjs') || (scriptTs(f) && f.endsWith('-test.ts'))) && !listed.includes(f));
  const steps = [
    // .mjs only: node --check parses a .ts file as plain JS. The .ts scripts get their syntax check from tsc,
    // whose erasableSyntaxOnly also refuses what Node's type stripping cannot run.
    ...files.filter((f) => f.endsWith('.mjs') || f === 'bin/graph-assay' || f === 'bin/cgqa').map((f) => ['node', '--check', p(f)]),
    ...files.filter((f) => f.endsWith('.sh')).map((f) => ['bash', '-n', p(f)]),
    ['node', p('lib/expect.ts')],
    ['node', p('oracle/test/run.ts'), '--mutate'],
    ['node', p('differential/test.ts')],
    ['node', p('labels/test.ts')],
    ['node', p('oracle/site-test.ts')],
    ['node', p('oracle/ts-cover-test.ts')],
    ['node', p('lib/scores-test.ts')],
    ['node', p('lib/spec-test.ts')],
    ['node', p('lib/anti-gaming-test.ts')],
    ['node', p('bench/robustness-test.ts')],
    ['node', p('bench/tables-test.ts')],
    ['node', p('bench/triage-test.ts')],
    ['node', p('tools/repro-test.mjs')],
    ...discovered.map((f) => ['node', p(f)]),
  ];
  // shellcheck where installed (CI's ubuntu runners have it); say so when it is not.
  const shells = files.filter((f) => f.endsWith('.sh'));
  if (spawnSync('shellcheck', ['--version']).status === 0) steps.push(['shellcheck', '-S', 'warning', ...shells.map((f) => p(f))]);
  else console.log('skip  shellcheck (not installed)');
  // A failing step's last TAIL lines; say how many came before, so a cut is never silent.
  const TAIL = 40;
  const tail = (text) => {
    const lines = text.trim().split('\n');
    return lines.length > TAIL ? [`(${lines.length - TAIL} earlier lines not shown)`, ...lines.slice(-TAIL)].join('\n') : lines.join('\n');
  };
  let failed = 0;
  for (const [c, ...a] of steps) {
    const r = spawnSync(c, a, { cwd: qa, encoding: 'utf8', env: { ...process.env, NODE_NO_WARNINGS: '1' } });
    // Only absolute arguments are paths; flags and plain words print as given.
    const label = `${c} ${a.map((x) => (path.isAbsolute(x) ? path.relative(qa, x) || x : x)).join(' ')}`;
    if (r.status !== 0) { failed++; console.log(`FAIL  ${label}${r.error ? ` (${r.error.message})` : r.signal ? ` (killed by ${r.signal})` : ''}\n${tail([r.stdout, r.stderr].map((s) => (s ?? '').trim()).filter(Boolean).join('\n'))}`); }
    else if (c === 'shellcheck') console.log(`ok    shellcheck: ${shells.length} scripts`);
    else if (!a.includes('--check') && c !== 'bash') console.log(`ok    ${label}: ${(r.stdout.trim().split('\n').pop() ?? '')}`);
  }
  // Type check last, so its verdict sits next to the summary (lib/typecheck.ts).
  // Imported here, not at the top: a broken lib/typecheck.ts must not take down other commands.
  let tc;
  try { tc = (await import('../lib/typecheck.ts')).typecheck(qa); } catch (e) {
    // The message and where it broke (lib/typecheck.ts, or a module it imports). A syntax error's
    // stack opens with `file:///...:line` and then Node-internal frames; otherwise use the first frame.
    const stack = String(e?.stack ?? '').split('\n');
    const frame = /^(file:\/\/|\/)\S*:\d+/.test(stack[0]) ? stack[0].trim() : stack.find((l) => /^\s+at /.test(l))?.trim();
    tc = { ok: false, lines: [`FAIL  typecheck: crashed: ${String(e?.message ?? e).split('\n')[0]}${frame ? ` (${frame})` : ''}`] };
  }
  if (!tc.ok) failed++;
  console.log(tc.lines.join('\n'));
  console.log(`${steps.length + 1} checks, ${failed} failed`);
  // exitCode, not exit(): exit() can cut off a large output still draining into a pipe.
  process.exitCode = failed ? 1 : 0;
} else {
  const entry = COMMANDS[cmd];
  if (!entry) { console.error(`unknown command ${cmd}; try graph-assay help`); process.exit(2); }
  const r = spawnSync(entry[0], [entry[1], ...args], { stdio: 'inherit' });
  if (r.error) console.error(`graph-assay ${cmd}: could not run ${entry[0]}: ${r.error.message}`);
  else if (r.signal) console.error(`graph-assay ${cmd}: killed by ${r.signal}`);
  process.exit(r.status ?? 1);
}
