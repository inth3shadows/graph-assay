#!/usr/bin/env node
// One entry point for graph-assay. `graph-assay help` lists the commands; each forwards its arguments
// to the script that does the work, so the scripts stay usable on their own.
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';
import * as path from 'node:path';

const qa = path.dirname(path.dirname(fs.realpathSync(fileURLToPath(import.meta.url))));
const p = (...x) => path.join(qa, ...x);
const COMMANDS = {
  setup: ['bash', p('tools/setup.sh'), '[--codegraph <commit>] [--no-codegraph] [--no-cgr] [--no-scip] [--dry-run]: SCIP tools and a build of each subject, where config looks'],
  replay: ['node', p('fixtures/replay.mjs'), '<codegraph.js> [fixture ...] [--json out] [--canary]: fixture verdicts and optional anonymous canary replay'],
  oracle: ['bash', p('oracle/run.sh'), '<name> <src repo> <ts|python|go|jvm> [ts dirs...]: index + SCIP + oracle, forward and missing'],
  'oracle-all': ['bash', p('oracle/run-all.sh'), '[targets file]: oracle on every target'],
  meta: ['node', p('metamorphic/run.mjs'), '<codegraph.js> <seed dir|fixtures ...> [--relations decoy,shift,repeat] [--json out]'],
  pycg: ['node', p('benchmarks/pycg.mjs'), '<codegraph.js> [category ...] [--json out]: PyCG micro-benchmark'],
  selftest: ['node', p('oracle/test/run.mjs'), '[--mutate] [--dump] [case ...]: hermetic oracle self-tests'],
  baseline: ['node', p('oracle/baseline.mjs'), 'save <dir> | diff <old baseline.json> <new baseline.json> [--fail-on-regression] [--json gate.json]'],
  snapshot: ['node', p('lib/subjects/codegraph.mjs'), 'snapshot <dir> <out.json> [codegraph.js] | index <dir> <codegraph.js>'],
  expect: ['node', p('lib/expect.mjs'), '[dir ...]: validate every expect.json'],
  config: ['node', p('lib/config.mjs'), '[key]: resolved paths'],
  conformance: ['node', p('lib/conformance.mjs'), '<codegraph.js>: is the adapter faithful, and how does the subject handle awkward cases'],
  modes: ['node', p('differential/modes.mjs'), '<codegraph.js> <dir ...> [--modes ..] [--json out]: execution modes (kernel, workers, sync, repeat) diffed against base'],
  builds: ['node', p('differential/builds.mjs'), '<old codegraph.js> <new codegraph.js> <dir ...> [--md out] [--json out] | --fetch <dest>: two builds, canonical graph diff'],
  triage: ['node', p('bench/triage.mjs'), '[--work <oracle work dir>] [--t3 <dir>] [--top N] [--md out] [--json out]: subject bugs ranked by the headline points they cost, from an oracle run'],
  site: ['node', p('oracle/site.mjs'), '<name | work dir> <file:line> [called name] [--subject s|all] [--no-scip]: one call site explained (records, meaning, SCIP definition, edges) and its re-run command'],
  shadow: ['node', p('differential/shadow.mjs'), '<old codegraph.js> <new codegraph.js> [questions.json] [--show N] [--json out]: agent-facing answers (explore, callers, ...) diffed between builds'],
};

const [cmd, ...args] = process.argv.slice(2);
if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') {
  console.log('usage: graph-assay <command> [args]\n');
  for (const [k, [, , help]] of Object.entries(COMMANDS)) console.log(`  ${k.padEnd(11)} ${help}`);
  console.log(`  ${'check'.padEnd(11)} syntax-check every script, type-check lib/, validate fixtures, self-tests with --mutate (what CI runs; needs 'npm ci --ignore-scripts' first)`);
  process.exit(cmd ? 0 : 2);
}

if (cmd === 'check') {
  const files = (spawnSync('git', ['ls-files'], { cwd: qa, encoding: 'utf8' }).stdout ?? '').split('\n').filter(Boolean);
  // Outside a git checkout the file list is empty and every syntax check would be skipped silently.
  if (!files.length) { console.error('check needs a git checkout (git ls-files listed nothing)'); process.exit(2); }
  const listed = ['lib/expect.mjs', 'oracle/test/run.mjs', 'differential/test.mjs', 'labels/test.mjs', 'oracle/site-test.mjs',
    'oracle/ts-cover-test.mjs', 'lib/scores-test.mjs', 'lib/spec-test.mjs', 'lib/anti-gaming-test.mjs', 'bench/robustness-test.mjs',
    'bench/tables-test.mjs', 'bench/triage-test.mjs', 'tools/repro-test.mjs'];
  // A new *-test.mjs runs without anyone remembering to list it.
  const discovered = files.filter((f) => f.endsWith('-test.mjs') && !listed.includes(f));
  const steps = [
    ...files.filter((f) => f.endsWith('.mjs') || f === 'bin/graph-assay' || f === 'bin/cgqa').map((f) => ['node', '--check', p(f)]),
    ...files.filter((f) => f.endsWith('.sh')).map((f) => ['bash', '-n', p(f)]),
    ['node', p('lib/expect.mjs')],
    ['node', p('oracle/test/run.mjs'), '--mutate'],
    ['node', p('differential/test.mjs')],
    ['node', p('labels/test.mjs')],
    ['node', p('oracle/site-test.mjs')],
    ['node', p('oracle/ts-cover-test.mjs')],
    ['node', p('lib/scores-test.mjs')],
    ['node', p('lib/spec-test.mjs')],
    ['node', p('lib/anti-gaming-test.mjs')],
    ['node', p('bench/robustness-test.mjs')],
    ['node', p('bench/tables-test.mjs')],
    ['node', p('bench/triage-test.mjs')],
    ['node', p('tools/repro-test.mjs')],
    ...discovered.map((f) => ['node', p(f)]),
  ];
  // shellcheck where installed (CI's ubuntu runners have it); say so when it is not.
  const shells = files.filter((f) => f.endsWith('.sh'));
  if (spawnSync('shellcheck', ['--version']).status === 0) steps.push(['shellcheck', '-S', 'warning', ...shells.map((f) => p(f))]);
  else console.log('skip  shellcheck (not installed)');
  // Type check (tsconfig.json). typescript is a dev dependency: a missing install fails the check, never skips it.
  const tsc = p('node_modules/typescript/bin/tsc');
  const typecheck = fs.existsSync(tsc);
  if (typecheck) steps.push(['node', tsc, '-p', '.', '--pretty', 'false']);
  let failed = typecheck ? 0 : 1;
  for (const [c, ...a] of steps) {
    const r = spawnSync(c, a, { cwd: qa, encoding: 'utf8', env: { ...process.env, NODE_NO_WARNINGS: '1' } });
    const label = `${c} ${a.map((x) => path.relative(qa, x) || x).join(' ')}`;
    // tsc --pretty false prints one line per error and no total: show them all, with the count.
    if (r.status !== 0 && a[0] === tsc && !r.error && !r.signal) {
      failed++; const out = `${r.stdout ?? ''}${r.stderr ?? ''}`.trim();
      console.log(`FAIL  typecheck: ${(out.match(/error TS\d+/g) ?? []).length} type errors (tsc -p .)\n${out}`);
    } else if (r.status !== 0) { failed++; console.log(`FAIL  ${label}${r.error ? ` (${r.error.message})` : r.signal ? ` (killed by ${r.signal})` : ''}\n${(`${r.stdout ?? ''}${r.stderr ?? ''}`).trim().split('\n').slice(-8).join('\n')}`); }
    else if (a[0] === tsc) console.log('ok    typecheck: tsc -p . (0 errors)');
    else if (c === 'shellcheck') console.log(`ok    shellcheck: ${shells.length} scripts`);
    else if (!a.includes('--check') && c !== 'bash') console.log(`ok    ${label}: ${(r.stdout.trim().split('\n').pop() ?? '')}`);
  }
  // Printed last so the cause sits next to the summary, not ~90 lines above it.
  if (!typecheck) console.log('FAIL  typecheck: node_modules/typescript is missing; run `npm ci --ignore-scripts` first');
  console.log(`${steps.length + (typecheck ? 0 : 1)} checks, ${failed} failed`);
  process.exit(failed ? 1 : 0);
}

const entry = COMMANDS[cmd];
if (!entry) { console.error(`unknown command ${cmd}; try graph-assay help`); process.exit(2); }
const r = spawnSync(entry[0], [entry[1], ...args], { stdio: 'inherit' });
if (r.error) console.error(`graph-assay ${cmd}: could not run ${entry[0]}: ${r.error.message}`);
else if (r.signal) console.error(`graph-assay ${cmd}: killed by ${r.signal}`);
process.exit(r.status ?? 1);
