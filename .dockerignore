# Allow only public benchmark code/data; never send local config, credentials or caches.
**
!Dockerfile
!.dockerignore
!docker/
!docker/**
!bin/
!bin/graph-assay
!bin/cgqa
!lib/
!lib/**
!oracle/
!oracle/*.sh
!oracle/*.ts
!oracle/package.json
!differential/
!differential/*.mjs
!corpus/
!corpus/v1.txt
!bench/
!bench/tables.mjs
!bench/robustness.mjs
!metamorphic/
!metamorphic/*.mjs
!benchmarks/
!benchmarks/pycg.mjs
!fixtures/
!fixtures/replay.mjs
!fixtures/oracle-candidates/
!fixtures/oracle-candidates/**
!schema/
!schema/**
!tools/
!tools/repro.mjs
!labels/
!labels/noise.mjs
!labels/questions.mjs
!labels/score.mjs
!labels/protocol.mjs
!labels/protocol.json
!labels/labellers.mjs
!labels/qualification/
!labels/qualification/**
!labels/data/
!labels/data/**
!SPEC.md
**/node_modules
**/.codegraph
**/.graph-assay
**/.git
**/.env*
