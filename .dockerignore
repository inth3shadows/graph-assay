# Allow only public benchmark code/data; never send local config, credentials or caches.
**
!Dockerfile
!.dockerignore
!docker/
!docker/**
!bin/
!bin/graph-assay
!bin/cgqa
!lib/
!lib/**
!oracle/
!oracle/*.sh
!oracle/*.ts
!oracle/package.json
!differential/
!differential/*.ts
!differential/package.json
!corpus/
!corpus/v1.txt
!bench/
!bench/tables.ts
!bench/robustness.ts
!bench/package.json
!metamorphic/
!metamorphic/*.ts
!metamorphic/package.json
!benchmarks/
!benchmarks/pycg.ts
!benchmarks/package.json
!fixtures/
!fixtures/replay.mts
!fixtures/oracle-candidates/
!fixtures/oracle-candidates/**
!schema/
!schema/**
!tools/
!tools/repro.mjs
!labels/
!labels/noise.mjs
!labels/questions.mjs
!labels/score.mjs
!labels/protocol.mjs
!labels/protocol.json
!labels/labellers.mjs
!labels/qualification/
!labels/qualification/**
!labels/data/
!labels/data/**
!SPEC.md
**/node_modules
**/.codegraph
**/.graph-assay
**/.git
**/.env*
